PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/agriflow
# Required; the server refuses to start without it (min 32 chars when NODE_ENV=production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
NODE_ENV=development
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ALLOWED_ORIGINS=http://localhost:5173
ML_SERVICE_URL=http://localhost:5001

# Direct-to-S3 image uploads (presigned POST). Production values come from SSM /agriflow/*.
# Leave empty to disable uploads (the presign endpoint returns 503).
UPLOADS_BUCKET=
UPLOADS_PUBLIC_BASE_URL=

# Postgres pool (defaults shown)
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=2000

# TLS to Postgres (RDS). Off by default.
# When DB_SSL is used, DATABASE_URL must NOT contain sslmode (or any ssl* param):
# node-pg lets connection-string SSL params override the ssl object built from these vars.
DB_SSL=false
# Optional: AWS RDS CA bundle (e.g. global-bundle.pem); when set, the server cert is verified against it.
DB_SSL_CA_PATH=
