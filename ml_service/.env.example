ML_SERVICE_PORT=5001
# Debug mode is on only when FLASK_ENV=development; never use that in production.
FLASK_ENV=production

# Folder the .pkl models are loaded from. Unset = "<repo>/ml models/models" (local runs).
# The Docker image sets MODELS_DIR=/models.
MODELS_DIR=
# Optional: download models from s3://$MODELS_S3_BUCKET/$MODELS_S3_PREFIX/ into MODELS_DIR
# at startup (skipped per file when the local size matches). Uses the default AWS
# credential chain (EC2 instance role); never put AWS keys here.
MODELS_S3_BUCKET=
MODELS_S3_PREFIX=
