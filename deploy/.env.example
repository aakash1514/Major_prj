# deploy/.env is read by every service in docker-compose.prod.yml (env_file).
# On EC2 it is generated by deploy/load-env.sh from SSM /agriflow/*. For local
# runs, copy this to deploy/.env and fill in local-only values.
# Placeholders only; never commit real values.

# --- backend ---
NODE_ENV=production
PORT=5000
# Postgres (RDS in prod). With DB_SSL=true, do NOT put sslmode or other ssl*
# params in DATABASE_URL: node-pg lets them override the ssl object.
DATABASE_URL=postgresql://USER:PASSWORD@your-rds-endpoint.ap-south-1.rds.amazonaws.com:5432/agriflow
DB_SSL=true
# Path inside the backend container to the RDS CA bundle (mount it if used).
DB_SSL_CA_PATH=
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=2000
# At least 32 characters when NODE_ENV=production.
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed browser origins.
ALLOWED_ORIGINS=https://app.example.com
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change-me
# Set by docker-compose.prod.yml (http://ml:5001); listed for completeness.
ML_SERVICE_URL=http://ml:5001

# --- ml ---
# The image sets MODELS_DIR=/models (named volume = model cache).
MODELS_DIR=/models
MODELS_S3_BUCKET=your-models-bucket
# Key prefix inside the bucket; may be empty.
MODELS_S3_PREFIX=models
FLASK_ENV=production
